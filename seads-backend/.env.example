# SEADS Backend — Environment Variables
# Copy to .env for local development. Set via Render dashboard for production.

# Server
PORT=3000
NODE_ENV=development

# Supabase — PostgreSQL direct connection string
# Find in: Supabase Dashboard → Settings → Database → Connection string → URI
# Use the "Session mode" connection string (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# Firebase Admin SDK — service account as base64
# Generate with: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# CORS — comma-separated allowed origins, or * for all
ALLOWED_ORIGIN=*
